# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun. .env asla commit edilmez.

# Slack app > OAuth & Permissions > Bot User OAuth Token (xoxb- ile baslar)
SLACK_BOT_TOKEN=xoxb-...

# Kanal ID'si (Slack'te kanala sag tik > View channel details > en altta "Channel ID", C ile baslar)
# Birden fazla kanal icin virgulle ayirin: C0123456789,C9876543210
# Bot her kanala ayrica /invite ile davet edilmis olmali.
SLACK_CHANNEL_ID=C0123456789

# Opsiyonel ayarlar
# POSTER_URL=https://vestaprimes.com/en/market-poster
# TZ_NAME=Europe/Istanbul
# LIVE_TIMEOUT_MS=60000

# --- Son dakika haber otomasyonu ---
# Haberlerin gidecegi kanal(lar). Bos birakilirsa SLACK_CHANNEL_ID kullanilir.
NEWS_CHANNEL_ID=C0123456789
# NEWS_MIN_SCORE=8          # gonderim esigi
# NEWS_MAX_AGE_HOURS=3      # bundan eski haber "son dakika" sayilmaz
# NEWS_MAX_PER_RUN=3        # tek turda azami haber sayisi

# --- FinancialJuice Telegram aktarimi ---
# Telegram akisinin gidecegi kanal(lar). Bos ise SLACK_CHANNEL_ID kullanilir.
TELEGRAM_CHANNEL_ID=C0123456789
# Ceviri icin Claude API anahtari (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5     # varsayilan; maliyet icin claude-haiku-4-5 secilebilir
# TELEGRAM_MAX_PER_RUN=15        # tek turda azami baslik
# TELEGRAM_FIRST_RUN=3           # ilk calistirmada alinacak baslik sayisi
